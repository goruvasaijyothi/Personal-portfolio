<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Personal Portfolio</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
    scroll-behavior:smooth;
}

body{
    background:#f5f7fb;
    color:#333;
    transition:0.4s;
}

/* Header */

header{
    position:fixed;
    width:100%;
    background:white;
    box-shadow:0 2px 10px rgba(0,0,0,.1);
    z-index:1000;
}

nav{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:15px 8%;
}

.logo{
    font-size:28px;
    color:#0077ff;
}

nav ul{
    display:flex;
    list-style:none;
}

nav ul li{
    margin-left:25px;
}

nav ul li a{
    text-decoration:none;
    color:#333;
    font-weight:500;
    transition:.3s;
}

nav ul li a:hover{
    color:#0077ff;
}

#theme-btn{
    padding:10px 15px;
    border:none;
    background:#0077ff;
    color:white;
    border-radius:8px;
    cursor:pointer;
}

/* Hero */

.hero{
    display:flex;
    justify-content:space-between;
    align-items:center;
    min-height:100vh;
    padding:120px 10%;
    gap:50px;
}

.hero-text{
    flex:1;
}

.hero-text h1{
    font-size:55px;
}

.hero-text span{
    color:#0077ff;
}

.hero-text h3{
    margin:20px 0;
    color:#555;
}

.hero-text p{
    line-height:1.8;
    margin-bottom:30px;
}

.btn{
    display:inline-block;
    padding:12px 25px;
    background:#0077ff;
    color:white;
    text-decoration:none;
    border-radius:6px;
    margin-right:10px;
}

.btn:hover{
    background:#005bd1;
}

.hero-image{
    flex:1;
    text-align:center;
}

.hero-image img{
    width:330px;
    border-radius:50%;
    box-shadow:0 10px 30px rgba(0,0,0,.2);
}

/* Sections */

section{
    padding:80px 10%;
}

section h2{
    text-align:center;
    margin-bottom:40px;
    color:#0077ff;
    font-size:35px;
}

/* About */

#about p{
    text-align:center;
    max-width:800px;
    margin:auto;
    line-height:1.8;
}

/* Skills */

.skills{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:20px;
}

.skill{
    background:#0077ff;
    color:white;
    text-align:center;
    padding:25px;
    border-radius:10px;
    transition:.3s;
}

.skill:hover{
    transform:translateY(-10px);
}

/* Projects */

.projects{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
}

.card{
    background:white;
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 5px 15px rgba(0,0,0,.1);
    transition:.3s;
}

.card:hover{
    transform:translateY(-10px);
}

.card img{
    width:100%;
    height:180px;
    object-fit:cover;
}

.card-content{
    padding:20px;
}

.card-content h3{
    margin-bottom:10px;
}

.card-content p{
    margin-bottom:15px;
}

.card-content a{
    color:white;
    background:#0077ff;
    text-decoration:none;
    padding:10px 20px;
    border-radius:5px;
}

/* Contact */

form{
    max-width:600px;
    margin:auto;
    display:flex;
    flex-direction:column;
}

input,textarea{
    margin:10px 0;
    padding:15px;
    border:1px solid #ccc;
    border-radius:5px;
}

textarea{
    resize:none;
    height:150px;
}

form button{
    padding:15px;
    border:none;
    background:#0077ff;
    color:white;
    cursor:pointer;
    border-radius:5px;
    font-size:18px;
}

footer{
    background:#111;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:40px;
}

/* Dark Theme */

.dark{
    background:#121212;
    color:white;
}

.dark header{
    background:#1b1b1b;
}

.dark nav ul li a{
    color:white;
}

.dark .card{
    background:#1d1d1d;
}

.dark input,
.dark textarea{
    background:#222;
    color:white;
    border:1px solid #444;
}

.dark footer{
    background:black;
}

/* Responsive */

@media(max-width:900px){

.hero{
    flex-direction:column-reverse;
    text-align:center;
}

.hero-text h1{
    font-size:40px;
}

.hero-image img{
    width:250px;
}

nav{
    flex-direction:column;
}

nav ul{
    margin:15px 0;
    flex-wrap:wrap;
    justify-content:center;
}

}
</style>

</head>

<body>

<header>

<nav>

<h2 class="logo">Portfolio</h2>

<ul>

<li><a href="#home">Home</a></li>

<li><a href="#about">About</a></li>

<li><a href="#skills">Skills</a></li>

<li><a href="#projects">Projects</a></li>

<li><a href="#contact">Contact</a></li>

</ul>

<button id="theme-btn">🌙</button>

</nav>

</header>

<!-- Hero -->

<section class="hero" id="home">

<div class="hero-text">

<h1>Hello, I'm <span>Your Name</span></h1>

<h3>Frontend Web Developer</h3>

<p>

I build responsive websites using HTML, CSS and JavaScript. I enjoy creating modern and user-friendly web experiences.

</p>

<a href="#projects" class="btn">My Projects</a>

<a href="#" class="btn">Download Resume</a>

</div>

<div class="hero-image">

<img src="https://via.placeholder.com/350" alt="Profile">

</div>

</section>

<!-- About -->

<section id="about">

<h2>About Me</h2>

<p>

I am a passionate web developer with experience in creating responsive and interactive websites. I enjoy learning new technologies and building beautiful web applications.

</p>

</section>

<!-- Skills -->

<section id="skills">

<h2>Skills</h2>

<div class="skills">

<div class="skill">HTML5</div>

<div class="skill">CSS3</div>

<div class="skill">JavaScript</div>

<div class="skill">Bootstrap</div>

<div class="skill">React</div>

<div class="skill">Git & GitHub</div>

</div>

</section>

<!-- Projects -->

<section id="projects">

<h2>Projects</h2>

<div class="projects">

<div class="card">

<img src="https://picsum.photos/400/200?1">

<div class="card-content">

<h3>Portfolio Website</h3>

<p>Modern responsive portfolio built with HTML, CSS and JavaScript.</p>

<a href="#">Live Demo</a>

</div>

</div>

<div class="card">

<img src="https://picsum.photos/400/200?2">

<div class="card-content">

<h3>Weather App</h3>

<p>Weather application using JavaScript and OpenWeather API.</p>

<a href="#">Live Demo</a>

</div>

</div>

<div class="card">

<img src="https://picsum.photos/400/200?3">

<div class="card-content">

<h3>Calculator</h3>

<p>Simple calculator using HTML, CSS and JavaScript.</p>

<a href="#">Live Demo</a>

</div>

</div>

</div>

</section>

<!-- Contact -->

<section id="contact">

<h2>Contact Me</h2>

<form id="contactForm">

<input type="text" placeholder="Your Name" required>

<input type="email" placeholder="Your Email" required>

<textarea placeholder="Your Message" required></textarea>

<button type="submit">Send Message</button>

</form>

</section>

<footer>

<p>© 2026 Your Name | Designed with ❤️</p>

</footer>

<script>
// Dark Mode

const btn=document.getElementById("theme-btn");

btn.onclick=function(){

document.body.classList.toggle("dark");

if(document.body.classList.contains("dark")){
btn.innerHTML="☀️";
}else{
btn.innerHTML="🌙";
}

}

// Contact Form

document.getElementById("contactForm").addEventListener("submit",function(e){

e.preventDefault();

alert("Thank you! Your message has been sent.");

this.reset();

});

// Fade Animation

const observer=new IntersectionObserver(entries=>{

entries.forEach(entry=>{

if(entry.isIntersecting){

entry.target.style.opacity="1";
entry.target.style.transform="translateY(0)";

}

});

});

document.querySelectorAll("section").forEach(section=>{

section.style.opacity="0";

section.style.transform="translateY(50px)";

section.style.transition="1s";

observer.observe(section);

});
</script>

</body>
</html>